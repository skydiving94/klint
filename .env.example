# Set KLINT_JUDGE_MODE=local for serverless in-process execution, or KLINT_JUDGE_MODE=remote for kev.serve HTTP
KLINT_JUDGE_MODE=local

# When KLINT_JUDGE_MODE=local, set KLINT_JUDGE_MODEL to a Hugging Face repo ID (e.g. jaredpalmer/kev-0.8b, jaredpalmer/kev-4b) or local path
# When KLINT_JUDGE_MODE=remote, set KLINT_JUDGE_MODEL=kev-latest
KLINT_JUDGE_MODEL=jaredpalmer/kev-4b

# Used only when KLINT_JUDGE_MODE=remote
KLINT_JUDGE_BASE_URL=http://127.0.0.1:8009
# KLINT_JUDGE_API_KEY=your-secret-key-if-enabled